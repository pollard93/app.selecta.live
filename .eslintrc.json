{
  "env": {
    "es6": true,
    "jest": true
  },
  "extends": "airbnb-base",
  "globals": {
    "fetch": false
  },
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint",
    "eslint-plugin-react",
    "react-native"
  ],
  "parserOptions": {
    "ecmaVersion": 2018,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "react/jsx-filename-extension": [
      1,
      {
        "extensions": [
          ".js",
          ".jsx",
          ".tsx"
        ]
      }
    ],
    "react/jsx-uses-react": [
      "error"
    ],
    "react/jsx-uses-vars": [
      "error"
    ],
    "comma-dangle": [
      "error"
    ],
    "semi": [
      "error",
      "always"
    ],
    "quotes": [
      "error",
      "single"
    ],
    "no-return-assign": [
      "off"
    ],
    "import/no-named-as-default": [
      "off"
    ],
    "import/no-named-as-default-member": [
      "off"
    ],
    "max-len": [
      "error",
      {
        "code": 200,
        "ignoreComments": true
      }
    ],
    "@typescript-eslint/no-unused-vars": [
      "error"
    ],
    "object-curly-newline": [
      "error",
      {
        "ImportDeclaration": "never"
      }
    ],
    "no-await-in-loop": [
      "off"
    ],
    "import/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": [
          "**/*.test.tsx",
          "**/*.stories.tsx",
          "scripts/*",
          "__mocks__/**/*",
          "setup-tests.js"
        ]
      }
    ],
    "no-case-declarations": [
      "off"
    ],
    "no-restricted-syntax": [
      "error",
      "WithStatement"
    ],
    "default-case": "off",
    "no-underscore-dangle": [
      "error",
      {
        "allowAfterThis": true
      }
    ],
    "no-plusplus": [
      "error",
      {
        "allowForLoopAfterthoughts": true
      }
    ],
    "import/prefer-default-export": "off",
    "react-native/no-color-literals": 2,
    "react-native/no-inline-styles": 2,
    "react-native/no-raw-text": 2,
    "react-native/no-single-element-style-arrays": 2,
    "react-native/no-unused-styles": 2,
    "react-native/sort-styles": [
      "error",
      "asc",
      {
        "ignoreClassNames": true
      }
    ],
    "react-native/split-platform-components": 2,
    "camelcase": [
      "error",
      {
        "allow": [
          "CONSUMER_NOTIFICATION_FRAGMENT_sender_profilePicture_url",
          "CONSUMER_NOTIFICATION_FRAGMENT_sender_profilePicture",
          "CONSUMER_NOTIFICATION_FRAGMENT_sender",
          "CONSUMER_NOTIFICATION_FRAGMENT",
          "FILE_FRAGMENT_url",
          "FILE_FRAGMENT",
          "USER_SELF_FRAGMENT_profilePicture_url",
          "USER_SELF_FRAGMENT_profilePicture",
          "USER_SELF_FRAGMENT",
          "deleteConsumerNotification",
          "deleteConsumerNotificationVariables",
          "login_login",
          "login",
          "loginVariables",
          "loginWithSocial_loginWithSocial",
          "loginWithSocial",
          "loginWithSocialVariables",
          "readConsumerNotification_readConsumerNotification",
          "readConsumerNotification",
          "readConsumerNotificationVariables",
          "register_register",
          "register",
          "registerVariables",
          "requestPasswordReset",
          "requestPasswordResetVariables",
          "getConsumerNotifications_getConsumerNotifications_notifications_sender_profilePicture_url",
          "getConsumerNotifications_getConsumerNotifications_notifications_sender_profilePicture",
          "getConsumerNotifications_getConsumerNotifications_notifications_sender",
          "getConsumerNotifications_getConsumerNotifications_notifications",
          "getConsumerNotifications_getConsumerNotifications",
          "getConsumerNotifications",
          "getConsumerNotificationsVariables",
          "getSelf_getSelf_profilePicture_url",
          "getSelf_getSelf_profilePicture",
          "getSelf_getSelf",
          "getSelf",
          "consumerNotifications_consumerNotifications_node_sender_profilePicture_url",
          "consumerNotifications_consumerNotifications_node_sender_profilePicture",
          "consumerNotifications_consumerNotifications_node_sender",
          "consumerNotifications_consumerNotifications_node",
          "consumerNotifications_consumerNotifications",
          "consumerNotifications",
          "putAccessToken",
          "putAccessTokenVariables",
          "removeAccessToken",
          "getAccessToken"
        ]
      }
    ]
  },
  "settings": {
    "import/resolver": {
      "node": {
        "paths": [
          "src"
        ],
        "extensions": [
          ".ts",
          ".tsx",
          ".js"
        ]
      }
    }
  },
  "overrides": [
    {
      "files": [
        "*.test.tsx"
      ],
      "rules": {
        "no-unused-expressions": "off"
      }
    }
  ]
}