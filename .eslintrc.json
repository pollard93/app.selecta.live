  "settings": {
    "import/resolver": {
      "node": {
        "paths": [
          "src"
        ],
        "extensions": [
          ".ts",
          ".tsx",
          ".js"
        ]
      }
    }
  },
  "overrides": [
    {
      "files": [
        "*.test.tsx"
      ],
      "rules": {
        "no-unused-expressions": "off"
      }
    }
  ]
